#!name=12306去广告
#!desc=移除12306广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-09-07
#!system=iOS, iPadOS
#!loon_version=3.5.1(983)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/12306/icon.jpg

[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Rewrite]
response if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$/i && ${response.status} == 200 then response.json.delete(["materialsList", "advertParam"])

[Mitm]
hostname = ad.12306.cn
