#!name=网易云音乐去广告
#!desc=移除网易云音乐广告
#!author=ccyykk666[https://github.com/ccyykk666], Keywos[https://github.com/Keywos]
#!system=ios
#!loon_version=3.5.1(983)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/icon.jpg
#!date=2026-09-11

[Argument]
LegacyHomeFramework = switch,true,tag=[首页框架] 旧版首页
TopRcmd = switch,true,tag=[顶部Tab] 推荐
TopMusic = switch,true,tag=[顶部Tab] 音乐
TopPodcast = switch,false,tag=[顶部Tab] 播客
TopBook = switch,false,tag=[顶部Tab] 听书
TopLive = switch,false,tag=[顶部Tab] 午夜飞行
TopAI = switch,false,tag=[顶部Tab] AI 写歌
BottomSimple = switch,true,tag=[底栏] 精简底栏

MineClean = switch,true,tag=[我的] 页面与侧栏净化
HideSongQuality = switch,true,tag=[歌单] 隐藏音质标识

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/api\/v6\/playlist\/detail(?:\?.*)?$/ && ${response.status} == 200 then response.json.jq("(.privileges | map(select(.payed == 1) | .id)) as $entitled | .privileges |= map(if .payed == 1 and .fee != 0 then .fee = 0 else . end) | .playlist.tracks |= map(.id as $id | if (($entitled | index($id)) != null and .fee != 0) then .fee = 0 else . end) | .playlist.trackIds |= map(del(.dpr)) | if ${HideSongQuality} then .privileges |= map(if (.flag | type) == \"number\" then .flag -= (((.flag / 65536 | floor) % 8) * 65536) else . end | if (.maxbr | type) == \"number\" and .maxbr > 320000 then .maxbr = 320000 else . end | if .maxbr == 0 and (.playMaxLevel | type) == \"number\" and .playMaxLevel > 320000 then .playMaxLevel = 320000 else . end | if .maxBrLevel == \"hires\" then .maxBrLevel = \"exhigh\" else . end) else . end")

[Script]
response if ${url} ~= /^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/x?eapi\/(?:batch|playlist\/(?:detail\/rcmd\/get|privilege)|homepage\/scene\/more\/rcmd\/song|comments\/activity\/airborne\/enable\/voice|v2\/resource\/comments|v2\/resource\/comment\/floor\/get|resource\/comments\/reply\/preload|moment\/tab\/info\/get|comment\/feed\/inserted\/resources(?:\/(?:combined|isolation))?|moment\/pub\/entrance\/get|moment\/song\/feed\/get|rtrs\/abt\/(?:front|web)\/expinfo\/list|link\/home\/framework\/(?:tab|top\/tab)|search\/(?:default\/keyword\/list|complex\/page\/v3|rcmd\/keyword\/get\/v2)|homepage\/block\/page|link\/scene\/show\/resource(?:\/scene-code\/player)?|v3\/song\/detail|song\/enhance\/(?:privilege|player\/url\/v1)|v3\/discovery\/recommend\/songs|v1\/artist\/top\/song|user\/sub\/artist\/exist|sp\/flow\/popup\/query|vipactivity\/app\/cashier\/setting\/get|v1\/user\/info|link\/position\/show\/resource|delivery\/batch-deliver|creator\/musician\/reminder\/message\/get)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/neteasemusic_ad_filter.js", {${BottomSimple}, ${LegacyHomeFramework}, ${TopRcmd}, ${TopMusic}, ${TopPodcast}, ${TopBook}, ${TopLive}, ${TopAI}, ${MineClean}}) with tag="网易云音乐净化", timeout=20, requires_body=true, binary_body_mode=true

[MitM]
hostname = ipv4.music.163.com, interface.music.163.com, interface2.music.163.com, interface3.music.163.com, interface4.music.163.com, interface5.music.163.com, music.163.com
