#!name=网易云音乐去广告
#!desc=移除网易云音乐广告
#!author=ccyykk666[https://github.com/ccyykk666], Keywos[https://github.com/Keywos]
#!system=ios
#!loon_version=3.5.1(988)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/icon.jpg
#!date=2026-09-11

[Argument]
LegacyHomeFramework = switch,true,tag=[首页框架] 旧版首页
TopRcmd = switch,true,tag=[顶栏] 推荐
TopMusic = switch,true,tag=[顶栏] 音乐
TopPodcast = switch,true,tag=[顶栏] 播客
TopBook = switch,false,tag=[顶栏] 听书
TopLive = switch,false,tag=[顶栏] 午夜飞行
TopAI = switch,false,tag=[顶栏] AI 写歌
BottomSimple = switch,true,tag=[底栏] 精简底栏

MineClean = switch,true,tag=[我的] 页面与侧栏净化
HideSongQuality = switch,true,tag=[歌单] 隐藏音质标识

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/api\/(?:v6\/playlist\/detail|chart\/playlist\/detail)\/?(?:\?.*)?$/ && ${response.status} == 200 then response.json.jq("def quality: if (.flag | type) == \"number\" and .flag >= 0 and .flag <= 9007199254740991 and (.flag | floor) == .flag then .flag -= ((((.flag / 65536 | floor) % 8) * 65536) + (((.flag / 4096 | floor) % 2) * 4096)) else . end | if (.maxbr | type) == \"number\" and .maxbr > 320000 then .maxbr = 320000 else . end | if .maxbr == 0 and (.playMaxLevel | type) == \"number\" and .playMaxLevel > 320000 then .playMaxLevel = 320000 else . end | if .maxBrLevel == \"hires\" then .maxBrLevel = \"exhigh\" else . end; def privilege: if type != \"object\" then . else (if .payed == 1 then .fee = 0 else . end) | if ${HideSongQuality} then quality else . end end; (if (.privileges | type) == \"array\" then reduce (.privileges[] | select(type == \"object\") | select(.payed == 1 and .id != null)) as $p ({}; .[($p.id | tostring)] = true) else {} end) as $entitled | if (.privileges | type) == \"array\" then .privileges |= map(privilege) else . end | if (.playlist.tracks | type) == \"array\" then .playlist.tracks |= map(if type == \"object\" then (if (.privilege | type) == \"object\" then .privilege |= privilege else . end) | (.id | tostring) as $id | if .privilege.payed == 1 or $entitled[$id] == true then .fee = 0 else . end else . end) else . end | if (.playlist.trackIds | type) == \"array\" then .playlist.trackIds |= map(if type == \"object\" then del(.dpr) else . end) else . end")

[Script]
response if ${url} ~= /^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/x?eapi\/(?:batch|v6\/playlist\/detail|chart\/playlist\/detail|song\/(?:mix\/detail|or\/podcast\/detail)|playlist\/(?:detail\/rcmd\/get|privilege)|homepage\/scene\/more\/rcmd\/song|comments\/activity\/airborne\/enable\/voice|v2\/resource\/comments|v2\/resource\/comment\/floor\/get|resource\/comments\/reply\/preload|moment\/tab\/info\/get|comment\/feed\/inserted\/resources(?:\/(?:combined|isolation))?|moment\/pub\/entrance\/get|moment\/song\/feed\/get|rtrs\/abt\/(?:front|web)\/expinfo\/list|link\/home\/framework\/(?:tab|top\/tab)|search\/(?:default\/keyword\/list|complex\/page\/v3|rcmd\/keyword\/get\/v2)|homepage\/block\/page|link\/scene\/show\/resource(?:\/scene-code\/player)?|v3\/song\/detail|song\/enhance\/(?:privilege|player\/url\/v1)|v3\/discovery\/recommend\/songs|v1\/artist\/top\/song|user\/sub\/artist\/exist|sp\/flow\/popup\/query|vipactivity\/app\/cashier\/setting\/get|v1\/user\/info|link\/position\/show\/resource|delivery\/batch-deliver|creator\/musician\/reminder\/message\/get)\/?(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/neteasemusic_ad_filter.js", {${BottomSimple}, ${LegacyHomeFramework}, ${TopRcmd}, ${TopMusic}, ${TopPodcast}, ${TopBook}, ${TopLive}, ${TopAI}, ${MineClean}, ${HideSongQuality}}) with tag="网易云音乐净化", timeout=20, requires_body=true, binary_body_mode=true

[MitM]
hostname = ipv4.music.163.com, interface.music.163.com, interface2.music.163.com, interface3.music.163.com, interface4.music.163.com, interface5.music.163.com, music.163.com
