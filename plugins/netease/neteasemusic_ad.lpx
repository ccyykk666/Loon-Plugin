#!name=网易云音乐去广告
#!desc=移除网易云音乐广告
#!author=ccyykk666[https://github.com/ccyykk666], Keywos[https://github.com/Keywos]
#!system=ios
#!loon_version=3.5.1(978)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/icon.jpg
#!date=2026-08-25

[Argument]
LegacyHomeFramework = switch,true,tag=[首页框架] 旧版首页,desc=开启后移除心动Tab并使用旧版首页；关闭后保留新版心动框架作为兼容锚点
# ===== 顶部 Tab =====
TopRcmd = switch,true,tag=[顶部Tab] 推荐,desc=显示“推荐”Tab
TopMusic = switch,true,tag=[顶部Tab] 音乐,desc=显示“音乐”Tab
TopPodcast = switch,false,tag=[顶部Tab] 播客,desc=显示“播客”Tab
TopBook = switch,false,tag=[顶部Tab] 听书,desc=显示“听书”Tab
TopLive = switch,false,tag=[顶部Tab] 午夜飞行,desc=显示“午夜飞行”Tab
TopAI = switch,false,tag=[顶部Tab] AI 写歌,desc=显示“AI 写歌”Tab
BottomSimple = switch,true,tag=[底栏] 精简底栏模块,desc=仅保留首页/我的；关闭后保留服务端原始底栏

# ===== 首页 =====
HomeSimple = switch,true,tag=[首页] 精简推荐模块,desc=移除问候语、快捷入口、音乐合伙人等运营模块

# ===== 我的 =====
MineClean = switch,true,tag=[我的] 页面与侧栏净化,desc=移除会员推广、菜单副标题、运营提示及 AI 写歌/商城/云村有票/云推歌

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/api\/v6\/playlist\/detail(?:\?.*)?$/ && ${response.status} == 200 then response.json.jq("(.privileges | map(select(.payed == 1) | .id)) as $entitled | .privileges |= map(if .payed == 1 and .fee != 0 then .fee = 0 else . end) | .playlist.tracks |= map(.id as $id | if (($entitled | index($id)) != null and .fee != 0) then .fee = 0 else . end) | .playlist.trackIds |= map(del(.dpr))")

[Script]
http-response ^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/x?eapi\/(?:batch|v2\/resource\/comments|v2\/resource\/comment\/floor\/get|resource\/comments\/reply\/preload|moment\/tab\/info\/get|comment\/feed\/inserted\/resources(?:\/(?:combined|isolation))?|moment\/pub\/entrance\/get|moment\/song\/feed\/get|link\/home\/framework\/(?:tab|top\/tab)|search\/default\/keyword\/list|homepage\/block\/page|link\/scene\/show\/resource(?:\/scene-code\/player)?|v3\/song\/detail|song\/enhance\/(?:privilege|player\/url\/v1)|v3\/discovery\/recommend\/songs|v1\/artist\/top\/song|user\/sub\/artist\/exist|sp\/flow\/popup\/query|vipactivity\/app\/cashier\/setting\/get|v1\/user\/info|link\/position\/show\/resource|delivery\/batch-deliver|creator\/musician\/reminder\/message\/get)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/neteasemusic_ad_filter.js, requires-body=true, binary-body-mode=true, timeout=20, tag=网易云音乐净化, argument=[{BottomSimple},{LegacyHomeFramework},{TopRcmd},{TopMusic},{TopPodcast},{TopBook},{TopLive},{TopAI},{MineClean}]

http-response ^https?:\/\/(?:(?:ipv4|interface\d*)\.music\.163\.com|music\.163\.com)\/x?eapi\/link\/page\/rcmd\/(?:resource\/show|block\/resource\/multi\/refresh)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/netease/neteasemusic_home_filter.js, requires-body=true, binary-body-mode=true, timeout=20, tag=首页推荐精简, argument=[{HomeSimple}], enable={HomeSimple}

[MitM]
hostname = ipv4.music.163.com, interface.music.163.com, interface2.music.163.com, interface3.music.163.com, interface4.music.163.com, interface5.music.163.com, music.163.com
