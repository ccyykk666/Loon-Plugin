#!name=QQ音乐去广告
#!desc=移除QQ音乐广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.1(988)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Argument]
CashEntry = switch,true,tag=[我的] 隐藏领现金（试验）

[Script]
response if ${url} ~= /^https:\/\/(?:szu6|u6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_ad_filter.js", {${CashEntry}}) with tag="QQ音乐去广告", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = u6.y.qq.com, szu6.y.qq.com
