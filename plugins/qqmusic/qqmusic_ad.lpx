#!name=QQ音乐去广告
#!desc=移除QQ音乐广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.3(1008)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Argument]
DeepClean = switch,true,tag=深度净化（首页、播放器、个人页）

[Rewrite]
response if ${url} ~= /^https:\/\/music\.y\.qq\.com\/maproxy\/getInfo(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json(?:\s*;|$)/i then response.json.jq("if type != \"object\" then . elif .ret != 0 then . elif (.rpt_msg_pos_ad_info | type) != \"array\" then . else .rpt_msg_pos_ad_info = [] end")

[Script]
response if ${DeepClean} == true && ${url} ~= /^https:\/\/(?:u6|szu6|shu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/octet-stream(?:\s*;|$)/i && ${response.header['Content-Encoding']} == null then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_enhanced_filter.js?v=enhanced-20261017-1") with tag="QQMusic-DeepClean", timeout=5, requires_body=true, binary_body_mode=true

[Mitm]
hostname = music.y.qq.com, u6.y.qq.com, szu6.y.qq.com, shu6.y.qq.com
