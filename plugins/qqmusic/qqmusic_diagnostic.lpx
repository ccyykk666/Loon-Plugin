#!name=QQ音乐网络诊断
#!desc=分阶段定位MITM、脚本及正文处理问题。阶段0仅MITM，1请求头放行，2请求正文放行，3请求解压解析后放行，4响应正文放行，5响应解压解析后放行。所有阶段保留原请求与响应。
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.3(1008)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Argument]
Stage = select,0,1,2,3,4,5,type=number,tag=诊断阶段（从0开始）

[Script]
request if ${Stage} == 1 && ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_probe.js?v=diag-20261017-1", "request-header") with tag="QQM-D1-Header", timeout=5
request if ${Stage} == 2 && ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_probe.js?v=diag-20261017-1", "request-body") with tag="QQM-D2-RequestBody", timeout=5, requires_body=true, binary_body_mode=true
request if ${Stage} == 3 && ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_decode_probe.js?v=diag-20261017-1") with tag="QQM-D3-RequestDecode", timeout=5, requires_body=true, binary_body_mode=true
response if ${Stage} == 4 && ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_probe.js?v=diag-20261017-1", "response-body") with tag="QQM-D4-ResponseBody", timeout=5, requires_body=true, binary_body_mode=true
response if ${Stage} == 5 && ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_response_decode_probe.js?v=diag-20261017-1") with tag="QQM-D5-ResponseDecode", timeout=5, requires_body=true, binary_body_mode=true

[Mitm]
hostname = u6.y.qq.com, szu6.y.qq.com
