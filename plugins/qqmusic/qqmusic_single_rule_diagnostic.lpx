#!name=QQ音乐单规则诊断
#!desc=独立配置对照：先禁用旧QQ音乐网络诊断和去广告插件。仅一条响应正文规则，复用阶段12的约8.8KB请求筛选脚本，异步原样放行；不解码响应，不去广告，无阶段参数。
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.3(1008)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Script]
response if ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_request_guard_probe.js?v=diag-20261017-8") with tag="QQM-Single-RequestGuard", timeout=5, requires_body=true, binary_body_mode=true

[Mitm]
hostname = u6.y.qq.com, szu6.y.qq.com
