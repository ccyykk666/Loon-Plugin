#!name=QQ音乐单规则诊断
#!desc=单规则诊断v2：沿用请求筛选和异步原样放行，新增ENTRY/CODEC_READY/BODY_READY/GUARD_READY/CALL_DONE时间标记。旧网络诊断和去广告插件保持禁用；不解码响应、不去广告。
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.3(1008)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Script]
response if ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_request_guard_trace.js?v=trace-20261017-1") with tag="QQM-Single-GuardTrace", timeout=5, requires_body=true, binary_body_mode=true

[Mitm]
hostname = u6.y.qq.com, szu6.y.qq.com
