#!name=QQ音乐单规则诊断
#!desc=单规则诊断v3：与v2保留同一解码筛选和五处日志，仅取消最终setTimeout，筛选后直接调用$done原样放行。观察CALL_DONE_SYNC；旧诊断和去广告插件保持禁用，无需选择阶段。
#!author=ccyykk666[https://github.com/ccyykk666]
#!date=2026-10-17
#!system=iOS, iPadOS
#!loon_version=3.5.3(1008)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/icon.png

[Script]
response if ${url} ~= /^https:\/\/(?:u6|szu6)\.y\.qq\.com\/cgi-bin\/musics\.fcg(?:\?[^#]*)?$/ && ${request.method} == "POST" && ${request.header['x-sign-data-type']} ~= /^json$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/qqmusic/qqmusic_request_guard_trace_sync.js?v=trace-20261017-2") with tag="QQM-Single-GuardTraceSync", timeout=5, requires_body=true, binary_body_mode=true

[Mitm]
hostname = u6.y.qq.com, szu6.y.qq.com
