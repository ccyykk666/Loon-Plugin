#!name=同程旅行去广告
#!desc=移除同程旅行广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!system=iOS, iPadOS
#!date=2026-09-01
#!loon_version=3.5.1(983)
#!icon=https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/tongcheng-travel/icon_20260901.png

[Rewrite]
# 首页红包弹窗与顶部站内信
request if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/appPopup(?:\?.*)?$/ then reject(200)

# 首页“新人限时加赠”
request if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/newmemberzone(?:\?.*)?$/ then reject(200)

# 首页下拉进入的“同程二楼”活动
request if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/getsecondfloorlist(?:\?.*)?$/ then reject(200)

# 首页与“我的”页面底部资讯流
request if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appfeeds\/recommend(?:\?.*)?$/ then reject(200)

[MITM]
hostname = tcmobileapi.17usoft.com
